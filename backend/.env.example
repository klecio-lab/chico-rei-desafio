APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8006
APP_PORT=8006
VITE_PORT=5174
FORWARD_DB_PORT=3307

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Auth API (config/api.php — BDR-001/003)
# Nome do personal access token emitido no login
# API_TOKEN_NAME=api
# Expiração do token de login, em dias
# API_TOKEN_EXPIRES_DAYS=15
# Rate limit do login (tentativas por minuto, por IP)
# THROTTLE_LOGIN_MAX=10
# Itens por página default na listagem de produtos (FormRequest limita 1-100)
# API_PAGINATION_DEFAULT=15
# Rate limit da leitura pública (requisições por minuto, por IP ou usuário)
# THROTTLE_READ_MAX=120
# Rate limit da escrita protegida (por minuto, por usuário logado)
# THROTTLE_WRITE_MAX=30
# Importação do catálogo externo (config/import.php — BDR-009)
# IMPORT_BASE_URL=https://chicorei.com
# IMPORT_TEMA=geek
# IMPORT_LIMIT=20
# IMPORT_THROTTLE_MS=1000
# IMPORT_TIMEOUT=15
# IMPORT_USER_AGENT=chico-rei-desafio/1.0 (+https://github.com/klecio-lab/chico-rei-desafio)
# IMPORT_ENABLED=true
# IMPORT_DEFAULT_STOCK=10
# Monitoramento (BDR-011): DSN vazio = SDK inativo, máquina limpa segura.
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
